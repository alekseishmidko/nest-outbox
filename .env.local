NODE_ENV=local
APP_PORT=3000

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=nest_outbox
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

ADMINER_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

LOG_LEVEL=debug
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_RETRY_JITTER_MS=250
OUTBOX_SHUTDOWN_TIMEOUT_MS=10000
SQL_SLOW_QUERY_THRESHOLD_MS=100
MEDIA_STORAGE_MODE=database
MEDIA_LOCAL_STORAGE_DIR=/app/storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media-assets

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=media-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
