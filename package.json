{
  "name": "nest-outbox",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "format:check": "npm --prefix backend run format:check",
    "lint:check": "npm --prefix backend run lint:check",
    "build": "npm --prefix backend run build",
    "test": "npm --prefix backend run test",
    "test:integration": "npm --prefix backend run test:integration",
    "test:e2e": "npm --prefix backend run test:e2e",
    "ci": "npm run format:check && npm run lint:check && npm run build && npm run test",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:dry-run": "npm --prefix backend run db:migrate:dry-run",
    "docker:local": "docker compose --env-file .env.local -f docker/docker-compose.local.yml up --build",
    "docker:prod": "docker compose --env-file .env.prod -f docker/docker-compose.prod.yml up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.local.yml -f docker/docker-compose.prod.yml down --remove-orphans",
    "docker:logs": "docker compose -f docker/docker-compose.local.yml logs -f",
    "load:smoke": "docker run --rm -e BASE_URL=http://host.docker.internal:3000 -v \"$PWD/load-tests:/scripts\" grafana/k6:0.54.0 run /scripts/smoke.js",
    "load:load": "docker run --rm -e BASE_URL=http://host.docker.internal:3000 -v \"$PWD/load-tests:/scripts\" grafana/k6:0.54.0 run /scripts/load.js",
    "load:stress": "docker run --rm -e BASE_URL=http://host.docker.internal:3000 -v \"$PWD/load-tests:/scripts\" grafana/k6:0.54.0 run /scripts/stress.js",
    "load:pagination": "docker run --rm -e BASE_URL=http://host.docker.internal:3000 -v \"$PWD/load-tests:/scripts\" grafana/k6:0.54.0 run /scripts/pagination-compare.js"
  }
}
