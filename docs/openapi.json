              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Cursor для cursor pagination.",
            "schema": {
              "example": "eyJjcmVhdGVkQXQiOiIyMDI2LTA4LTA1VDAwOjAwOjAwLjAwMFoiLCJvcmRlcklkIjoxMDB9",
