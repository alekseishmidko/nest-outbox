  "info": {
    "title": "Nest Outbox API",
    "description": "Versioned HTTP contract for Nest Outbox API.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "example": "Alex",
            "minLength": 1,
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "example": "correct horse battery staple",
            "minLength": 12
          },
          "avatarSeed": {
            "type": "string",
            "example": "alex-avatar"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct horse battery staple"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh JWT из предыдущего login/refresh."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ReceiveInboxEventDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "example": "payment-evt-123"
          },
          "eventType": {
            "type": "string",
            "example": "payment.completed"
          },
          "payload": {
            "type": "object",
            "example": {
              "orderId": 42,
              "amount": 199.9
            }
          }
        },
        "required": [
          "eventId",
          "eventType",
          "payload"
        ]
      },
      "CreateMapDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Название карты.",
            "example": "Central Park QR map",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "description": "Описание карты.",
            "example": "Точка для генерации QR-code."
          },
          "latitude": {
            "type": "number",
            "description": "Широта.",
            "example": 40.785091
          },
          "longitude": {
            "type": "number",
            "description": "Долгота.",
            "example": -73.968285
          },
          "ownerUserId": {
            "type": "number",
            "description": "ID пользователя-владельца карты.",
            "example": 1
          }
        },
        "required": [
          "title",
          "latitude",
          "longitude",
          "ownerUserId"
        ]
      },
      "UpdateMapDto": {
        "type": "object",
        "properties": {
          "ownerUserId": {
            "type": "number",
            "description": "Новый владелец карты."
          },
          "title": {
            "type": "string",
            "description": "Новое название карты.",
            "example": "Updated QR map",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "description": "Новое описание карты.",
            "example": "Обновленное описание."
          },
          "latitude": {
            "type": "number",
            "description": "Новая широта.",
            "example": 40.785091
          },
          "longitude": {
            "type": "number",
            "description": "Новая долгота.",
            "example": -73.968285
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email пользователя. Должен быть уникальным.",
            "example": "user@example.com",
            "maxLength": 320
          },
          "name": {
            "type": "string",
            "description": "Отображаемое имя пользователя.",
            "example": "Alex",
            "minLength": 1,
            "maxLength": 255
          },
          "avatarSeed": {
            "type": "string",
            "description": "Seed для генерации avatar. Если не передан, будет создан автоматически.",
            "example": "alex-avatar-seed",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Новый email пользователя. Должен быть уникальным.",
            "example": "new-user@example.com",
            "maxLength": 320
          },
          "name": {
            "type": "string",
            "description": "Новое отображаемое имя пользователя.",
            "example": "Alex Updated",
            "minLength": 1,
            "maxLength": 255
          },
          "avatarSeed": {
            "type": "string",
            "description": "Новый seed для генерации avatar.",
            "example": "alex-updated-seed",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {}
      },
      "GenerateUserAvatarDto": {
        "type": "object",
        "properties": {
          "seed": {
            "type": "string",
            "description": "Переопределяет `users.avatar_seed` для конкретной генерации.",
            "example": "custom-avatar-seed",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "GenerateMapQrDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL, который будет закодирован в QR-code.",
            "example": "https://example.com/maps/1",
            "maxLength": 2048
          },
          "payload": {
            "type": "string",
            "description": "Произвольный payload для QR-code. Используется, если `url` не передан.",
            "example": "{\"mapId\":1,\"source\":\"manual\"}",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "number",
            "description": "ID пользователя, который создает заказ.",
            "example": 1,
            "minimum": 1
          },
          "mapId": {
            "type": "number",
            "description": "ID карты, связанной с заказом.",
            "example": 1,
            "minimum": 1
          },
          "totalAmount": {
            "type": "number",
            "description": "Сумма заказа.",
            "example": 199.9,
            "minimum": 0
          }
        },
        "required": [
          "userId",
          "mapId",
          "totalAmount"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Новый статус заказа.",
            "enum": [
              "pending",
              "paid",
              "completed",
              "cancelled",
              "failed"
            ],
            "example": "paid"
          },
          "version": {
            "type": "number",
            "description": "Текущая версия заказа для optimistic locking.",
            "example": 0,
            "minimum": 0
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "UpdateOrderStatusPessimisticDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Новый статус заказа.",
            "enum": [
              "pending",
              "paid",
              "completed",
              "cancelled",
              "failed"
            ],
            "example": "paid"
          }
        },
        "required": [
          "status"
        ]
      },
      "RetryOutboxEventDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Причина ручного повтора обработки события.",
            "example": "Исправлена внешняя ошибка генерации media, можно повторить.",
            "minLength": 3,
            "maxLength": 512
          }
        },
        "required": [
          "reason"
        ]
      },
      "RoutePointDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "example": 40.785091
          },
          "longitude": {
            "type": "number",
            "example": -73.968285
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "CalculateDistanceDto": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/RoutePointDto"
          },
          "destination": {
            "$ref": "#/components/schemas/RoutePointDto"
          }
        },
        "required": [
          "origin",
          "destination"
        ]
      },
      "SearchRouteDto": {
        "type": "object",
        "properties": {
          "originMapId": {
            "type": "number",
            "example": 1,
            "minimum": 1
          },
          "destinationMapId": {
            "type": "number",
            "example": 2,
            "minimum": 1
          },
          "candidateRadiusKm": {
            "type": "number",
            "default": 25,
            "minimum": 0.1,
            "maximum": 500
          },
          "limit": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "originMapId",
          "destinationMapId"
        ]
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "statusCode",
          "errorCode",
          "message",
          "path",
          "method",
          "timestamp"
        ],
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "errorCode": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "example": "/orders"
          },
          "method": {
            "type": "string",
            "example": "POST"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "nullable": true
          }
        }
      }
    }
  }
}
